{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "async": true,
            "type": "command",
            "command": "npm run fix 2>&1 || true",
            "timeout": 120,
            "statusMessage": "Running npm run fix..."
          }
        ]
      }
    ]
  }
}
