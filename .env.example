# ─── Gmail Toolkit — Environment Configuration ──────────────────────────────
# Copy this file to `.env` and adjust as needed:  cp .env.example .env
#
# Every variable below is OPTIONAL — the toolkit runs on the defaults shown.
# This file contains NO secrets: the OAuth client secret and token live in the
# JSON files referenced by the *_PATH variables, which are git-ignored.

# Path to the OAuth client-secrets JSON downloaded from Google Cloud Console
# (the "installed"/desktop app credentials).
GMAIL_CREDENTIALS_PATH=./credentials.json

# Path where the OAuth token is persisted after the first browser consent flow.
# Written with 0600 permissions; never commit it.
GMAIL_TOKEN_PATH=./token.json

# Loopback port for the one-time OAuth consent callback. The callback server is
# always bound to 127.0.0.1, so changing this never exposes it to the LAN — it
# only avoids a collision when port 3000 is already in use. Google's loopback
# flow permits any port for desktop/installed apps. Must be an integer 1–65535.
GMAIL_OAUTH_PORT=3000

# Log verbosity written to stderr. One of: debug | info | warn | error | silent
GMAIL_LOG_LEVEL=info

# Comma-separated MCP tool names to force-ENABLE (e.g. destructive tools that
# are disabled by default). Leave unset to keep the built-in defaults.
# GMAIL_ENABLE_TOOLS=

# Comma-separated MCP tool names to force-DISABLE. Takes precedence over
# GMAIL_ENABLE_TOOLS when a name appears in both.
# GMAIL_DISABLE_TOOLS=
