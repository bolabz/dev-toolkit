{
  "name": "dev-toolkit",
  "version": "0.2.0",
  "description": "TypeScript developer toolkit for third-party SDK integrations with MCP server exposure — Gmail is the first module.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "docs/architecture.mermaid",
    "docs/dev-toolkit.api.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "bin": {
    "gmail-mcp": "dist/gmail/mcp/server.js"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "tsx src/gmail/mcp/server.ts",
    "start": "node dist/gmail/mcp/server.js",
    "setup-auth": "tsx scripts/setup-auth.ts",
    "typecheck": "tsc --noEmit",
    "prettier:fix": "prettier --write .",
    "lint:fix": "eslint --max-warnings 0 --fix src/ tests/",
    "knip:fix": "knip --fix",
    "fix": "npm run knip:fix && npm run lint:fix && npm run prettier:fix",
    "lint:check": "eslint --max-warnings 0 src/ tests/",
    "prettier:check": "prettier --check .",
    "knip:check": "knip",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "docs:check": "typedoc --emit none",
    "format:check": "npm run prettier:check && npm run lint:check",
    "check": "npm run fix && npm run typecheck && npm run format:check && npm run docs:check && npm run deps:check && npm run knip:check",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test": "npm run check && npm run test:unit",
    "docs:update": "typedoc",
    "api:update": "api-extractor run --config api-extractor.json --local",
    "deps:diagram:mermaid": "depcruise src --config .dependency-cruiser.cjs --output-type mermaid --output-to docs/architecture.mermaid",
    "deps:diagram:svg": "mmdc -i docs/architecture.mermaid -o docs/architecture.svg",
    "deps:diagram:update": "npm run deps:diagram:mermaid && npm run deps:diagram:svg",
    "docs:fresh": "npm run deps:diagram:update && git diff --exit-code HEAD -- docs/architecture.mermaid docs/architecture.svg",
    "docs": "npm run docs:update && npm run api:update && npm run deps:diagram:update",
    "clean": "rm -rf dist logs docs/typedoc",
    "compile": "tsc -p tsconfig.build.json",
    "build": "npm run clean && npm run compile",
    "ci": "npm run docs:fresh && npm run test && npm run build"
  },
  "keywords": [
    "gmail",
    "mcp",
    "email",
    "google",
    "claude"
  ],
  "license": "UNLICENSED",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "email-reply-parser": "^2.3.5",
    "google-auth-library": "^10.0.0",
    "googleapis": "^171.0.0",
    "he": "^1.2.0",
    "html-to-text": "^9.0.5",
    "open": "^11.0.0",
    "p-queue": "^9.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@microsoft/api-extractor": "^7.58.2",
    "@types/he": "^1.2.3",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^25.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.9.0",
    "knip": "^6.3.1",
    "lefthook": "^2.1.5",
    "prettier": "^3.8.2",
    "tsx": "^4.19.0",
    "typedoc": "^0.28.18",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.0.0"
  }
}
