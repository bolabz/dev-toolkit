{
  "name": "gmail-toolkit",
  "version": "0.1.0",
  "description": "Three-layer TypeScript toolkit for comprehensive Gmail management — standalone library and MCP server",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gmail-toolkit": "dist/mcp-server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/mcp-server.ts",
    "start": "node dist/mcp-server.js",
    "setup-auth": "tsx scripts/setup-auth.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts",
    "clean": "rm -rf dist"
  },
  "keywords": ["gmail", "mcp", "email", "google", "claude"],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "googleapis": "^144.0.0",
    "google-auth-library": "^9.14.0",
    "open": "^10.1.0",
    "zod": "^3.23.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "html-to-text": "^9.0.5",
    "mailparser": "^3.7.1",
    "email-reply-parser": "^2.3.5",
    "p-queue": "^8.0.1",
    "he": "^1.2.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "tsx": "^4.19.0",
    "@types/he": "^1.2.3",
    "@types/mailparser": "^3.4.4",
    "@types/html-to-text": "^9.0.4",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  }
}
