{
  "name": "gmail-toolkit",
  "version": "0.1.0",
  "description": "Three-layer TypeScript toolkit for comprehensive Gmail management — standalone library and MCP server",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "etc/",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "gmail-toolkit": "dist/mcp-server.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint:check": "eslint --max-warnings 0 src/ tests/",
    "lint:fix": "eslint --max-warnings 0 --fix src/ tests/",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "format:check": "npm run prettier:check && npm run lint:check",
    "format:fix": "npm run prettier:write && npm run lint:fix",
    "clean": "rm -rf dist coverage docs/typedoc",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "deps:diagram": "depcruise src --config .dependency-cruiser.cjs --output-type archi | dot -T svg > docs/architecture.svg",
    "deps:diagram:mermaid": "depcruise src --config .dependency-cruiser.cjs --output-type mermaid --output-to docs/architecture.mermaid",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "test": "npm run typecheck && npm run format:check && npm run docs:check && npm run deps:check && npm run knip && npm run test:unit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx src/mcp-server.ts",
    "start": "node dist/mcp-server.js",
    "setup-auth": "tsx scripts/setup-auth.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "api:check": "api-extractor run --config api-extractor.json",
    "api:update": "api-extractor run --config api-extractor.json --local",
    "ci": "npm run build && npm run api:check && npm run test",
    "docs": "typedoc",
    "docs:check": "typedoc --emit none",
    "prepare": "lefthook install"
  },
  "keywords": [
    "gmail",
    "mcp",
    "email",
    "google",
    "claude"
  ],
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "email-reply-parser": "^2.3.5",
    "google-auth-library": "^9.14.0",
    "googleapis": "^144.0.0",
    "he": "^1.2.0",
    "html-to-text": "^9.0.5",
    "mailparser": "^3.7.1",
    "open": "^10.1.0",
    "p-queue": "^8.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.2",
    "@types/he": "^1.2.3",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.4",
    "@types/node": "^22.19.17",
    "@vitest/coverage-v8": "^2.1.9",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.9.0",
    "knip": "^6.3.1",
    "lefthook": "^2.1.5",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typedoc": "^0.28.18",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.58.1",
    "vitest": "^2.0.0"
  }
}
